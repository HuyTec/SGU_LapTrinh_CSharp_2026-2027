@model Exam.Services.LecturerClassService.Page
@{ var selected = Model.Selected!; ViewData["Title"] = "Lớp " + selected.Code; }
<a asp-action="Index" class="back-link">Về danh sách lớp</a>
<section class="page-heading">
    <div>
        <h1>Lớp @selected.Code</h1>
        <p>@selected.Subject · @(selected.IsActive ? "Đang hoạt động" : "Đã ngừng")</p>
    </div>
    <span class="status-tag">@Model.Members.Count thí sinh</span>
</section>
@if (selected.IsActive)
{
    <form asp-action="Add" method="post" class="surface mb-4">
        <h2>Thêm thí sinh</h2>
        <input type="hidden" name="id" value="@selected.Id" />
        <label for="studentCode" class="form-label">Mã thí sinh đang hoạt động</label>
        <input id="studentCode" name="code" class="form-control mb-3" maxlength="30" required />
        <button type="submit" class="btn btn-primary">Thêm vào lớp</button>
    </form>
}
<section class="surface">
    <h2>Danh sách thí sinh</h2>
    @if (Model.Members.Count == 0) { <p>Lớp chưa có thí sinh.</p> }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">Mã thí sinh</th><th scope="col">Họ tên</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var member in Model.Members)
                {
                    <tr>
                        <td>@member.Code</td><td>@member.Name</td><td>@(member.IsActive ? "Đang hoạt động" : "Đã khóa")</td>
                        <td>
                            <form asp-action="Remove" method="post" onsubmit="return confirm('Gỡ thí sinh khỏi lớp? Bài thi và kết quả đã có được giữ lại.');">
                                <input type="hidden" name="id" value="@selected.Id" />
                                <input type="hidden" name="studentId" value="@member.Id" />
                                <button type="submit" class="btn btn-outline-danger">Gỡ khỏi lớp</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
