@model Exam.Services.LecturerClassService.Page
@{ ViewData["Title"] = "Lớp học"; var subjects = Model.Subjects; }
<h1>Lớp học</h1>
@if (subjects.Count > 0)
{
    <form asp-action="Create" method="post" class="surface p-3 mb-4">
        <label for="subjectId" class="form-label">Môn được phân công</label>
        <select id="subjectId" name="subjectId" class="form-select mb-3" required>
            @foreach (var subject in subjects) { <option value="@subject.Value">@subject.Label</option> }
        </select>
        <label for="code" class="form-label">Mã lớp</label>
        <input id="code" name="code" class="form-control mb-3" maxlength="50" required />
        <button type="submit" class="btn btn-primary">Tạo lớp</button>
    </form>
}
else { <p>Bạn chưa được phân công môn đang hoạt động để tạo lớp.</p> }
@if (Model.Classes.Count == 0) { <p>Chưa có lớp trong các môn được phân công.</p> }
<ul class="list-group">
@foreach (var item in Model.Classes)
{
    <li class="list-group-item p-0"><a asp-action="Details" asp-route-id="@item.Id" class="d-block p-3 text-decoration-none"><strong>@item.Code</strong> · @item.Subject · @(item.IsActive ? "Đang hoạt động" : "Đã ngừng") <span class="ms-2">Xem thí sinh trong lớp</span></a></li>
}
</ul>
