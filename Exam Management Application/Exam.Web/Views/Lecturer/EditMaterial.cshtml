@model Exam.Web.Controllers.LecturerController.MaterialEditor
@{
    var resource = Model.Definition.Key;
    ViewData["Title"] = (Model.Id.HasValue ? "Sửa " : "Thêm ") + (resource == "questions" ? "câu hỏi" : "chủ đề");
}
<section class="surface">
    <h1>@ViewData["Title"]</h1>
    <form asp-action="SaveMaterial" asp-route-resource="@resource" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        @foreach (var field in Model.Definition.Fields)
        {
            var value = Model.Values.GetValueOrDefault(field.Name) ?? "";
            if (field.Type == "hidden")
            {
                <input type="hidden" name="@field.Name" value="@value" />
            }
            else if (field.Type == "checkbox")
            {
                <div class="form-check mb-3">
                    <input id="@field.Name" name="@field.Name" type="checkbox" value="true" checked="@(string.Equals(value, "true", StringComparison.OrdinalIgnoreCase))" class="form-check-input" />
                    <label for="@field.Name" class="form-check-label">@field.Label</label>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label for="@field.Name" class="form-label">@field.Label</label>
                    @if (field.Type == "select")
                    {
                        <select id="@field.Name" name="@field.Name" required="@field.Required" class="form-select">
                            <option value="">Chọn @field.Label.ToLowerInvariant()</option>
                            @foreach (var choice in field.Choices ?? [])
                            {
                                var label = choice.Label switch { "Easy" => "Dễ", "Medium" => "Trung bình", "Hard" => "Khó", _ => choice.Label };
                                <option value="@choice.Value" selected="@(choice.Value == value)">@label</option>
                            }
                        </select>
                    }
                    else if (field.Name == "text")
                    {
                        <textarea id="@field.Name" name="@field.Name" rows="3" required="@field.Required" maxlength="2000" class="form-control">@value</textarea>
                    }
                    else
                    {
                        <input id="@field.Name" name="@field.Name" value="@value" required="@field.Required" maxlength="@(resource == "topics" ? 150 : 2000)" class="form-control" />
                    }
                </div>
            }
        }
        <div class="action-row">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Materials" asp-route-resource="@resource" class="btn btn-outline-secondary">Quay lại</a>
            @if (Model.Id is int reloadId && Context.Response.StatusCode == 409)
            {
                <a asp-action="EditMaterial" asp-route-resource="@resource" asp-route-id="@reloadId">Tải bản mới nhất</a>
            }
        </div>
    </form>
    @if (Model.Id is int deleteId)
    {
        <details class="mt-3">
            <summary>Xóa mục này</summary>
            <p class="mt-2">Chỉ có thể xóa mục chưa được tham chiếu.</p>
            <form asp-action="DeleteMaterial" asp-route-resource="@resource" asp-route-id="@deleteId" method="post">
                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            </form>
        </details>
    }
</section>
