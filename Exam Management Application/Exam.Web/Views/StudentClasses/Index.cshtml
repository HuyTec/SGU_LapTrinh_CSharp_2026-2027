@model IReadOnlyList<Exam.Services.ExamService.StudentClassRow>
@{ ViewData["Title"] = "Lớp của tôi"; }
<h1>Lớp của tôi</h1>
@if (Model.Count == 0)
{
    <p>Bạn chưa được thêm vào lớp nào.</p>
}
@foreach (var item in Model)
{
    <section class="surface mb-3">
        <h2>@item.Code · @item.Subject</h2>
        @if (!item.Active)
        {
            <p class="muted">Lớp hoặc môn đã ngừng hoạt động.</p>
        }
        <p><strong>Giảng viên được phân công theo môn:</strong>
            @(item.Lecturers.Count == 0 ? "Chưa có giảng viên" : string.Join(", ", item.Lecturers))
        </p>
        <h3>Đợt thi của lớp</h3>
        @if (item.Sessions.Count == 0)
        {
            <p class="muted">Chưa có đợt thi hiển thị cho bạn.</p>
        }
        else
        {
            <li class="list-group-item p-0"><a asp-action="Details" asp-route-id="@item.Id" class="d-block p-3 text-decoration-none"><strong>@item.Code</strong> · @item.Subject · @(item.IsActive ? "Đang hoạt động" : "Đã ngừng") <span class="ms-2">Xem lớp</span></a></li>
        }
    </section>
}
