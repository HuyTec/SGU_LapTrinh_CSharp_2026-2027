@model IReadOnlyList<Exam.Services.StudentClassService.ClassRow>
@{ ViewData["Title"] = "Lớp của tôi"; }
<h1>Lớp của tôi</h1>
@if (ViewData["DemoEnrollment"] is true)
{
    <form asp-action="JoinDemo" method="post" class="surface mb-4">
        <label for="code" class="form-label">Mã lớp thử</label>
        <input id="code" name="code" class="form-control mb-3" maxlength="50" required />
        <button type="submit" class="btn btn-primary">Tham gia lớp thử</button>
    </form>
}
@if (Model.Count == 0)
{
    <p>Bạn chưa tham gia lớp nào.</p>
}
else
{
    <ul class="list-group mb-4">
        @foreach (var item in Model)
        {
            <li class="list-group-item p-0"><a asp-action="Details" asp-route-id="@item.Id" class="d-block p-3 text-decoration-none"><strong>@item.Code</strong> · @item.Subject · @(item.IsActive ? "Đang hoạt động" : "Đã ngừng") <span class="ms-2">Xem lớp</span></a></li>
        }
    </ul>
}
<a asp-controller="Sessions" asp-action="Index">Xem đợt thi</a>
