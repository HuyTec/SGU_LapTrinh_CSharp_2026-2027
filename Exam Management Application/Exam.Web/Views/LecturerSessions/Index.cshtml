@model IReadOnlyList<Exam.Services.LecturerSessionRow>
@{ ViewData["Title"] = "Đợt thi giảng viên"; }
<section class="page-heading">
    <div><h1>Đợt thi</h1><p>Tổ chức thi cho các lớp thuộc môn bạn phụ trách.</p></div>
    <a asp-action="Edit" class="btn btn-primary">Tạo đợt nháp</a>
</section>
@if (Model.Count == 0)
{
    <p class="surface">Bạn chưa có đợt thi nào.</p>
}
else
{
    <div class="table-responsive surface">
        <table class="table align-middle">
            <thead><tr><th>Đợt thi</th><th>Đề</th><th>Trạng thái</th><th>Mã và link</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.Title</td><td>@row.Paper</td>
                    <td>@(row.State switch { "Draft" => "Nháp", "Scheduled" => "Sắp mở", "Open" => "Đang mở", "Closed" => "Đã đóng", "Cancelled" => "Đã hủy", _ => row.State })</td>
                    <td>
                        @if (row.Code is not null)
                        {
                            var link = Url.Action("Join", "Sessions", new { code = row.Code }, Context.Request.Scheme);
                            <label class="form-label" for="link-@row.Id"><strong>@row.Code</strong></label>
                            <input id="link-@row.Id" class="form-control" type="url" value="@link" readonly />
                        }
                    </td>
                    <td>
                        <div class="action-row">
                            @if (row.CanEdit)
                            {
                                <a asp-action="Edit" asp-route-id="@row.Id" class="btn btn-outline-secondary">Sửa</a>
                                <form asp-action="ChangeState" asp-route-id="@row.Id" method="post">
                                    <button type="submit" class="btn btn-primary" name="command" value="activate">Kích hoạt</button>
                                </form>
                            }
                            @if (row.CanWithdraw)
                            {
                                <form asp-action="ChangeState" asp-route-id="@row.Id" method="post">
                                    <button type="submit" class="btn btn-outline-secondary" name="command" value="postpone">Hoãn</button>
                                    <button type="submit" class="btn btn-outline-danger" name="command" value="cancel">Hủy</button>
                                </form>
                            }
                            <a asp-controller="LecturerResults" asp-action="Index" asp-route-id="@row.Id" class="btn btn-outline-secondary">Theo dõi</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
