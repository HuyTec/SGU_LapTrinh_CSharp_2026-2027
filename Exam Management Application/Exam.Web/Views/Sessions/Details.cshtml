@model SessionDetailVm
@{ ViewData["Title"] = Model.Session.Title; var session=Model.Session; }
<a asp-action="Index" class="back-link">Về danh sách đợt thi</a>
<div class="page-heading"><div><p class="uc-label">UC-05, UC-06</p><h1>@session.Title</h1><p class="muted">@session.Subject</p></div><span class="status-tag" data-status="@session.Status">@session.Status</span></div>
<section class="surface mb-4"><h2>Thông tin đợt thi</h2><dl class="detail-grid"><div><dt>Mở đợt thi</dt><dd><time data-local-time="@DateTime.SpecifyKind(session.OpensAt, DateTimeKind.Utc).ToString("O")">@session.OpensAt.ToString("dd/MM/yyyy HH:mm") UTC</time></dd></div><div><dt>Đóng đợt thi</dt><dd><time data-local-time="@DateTime.SpecifyKind(session.ClosesAt, DateTimeKind.Utc).ToString("O")">@session.ClosesAt.ToString("dd/MM/yyyy HH:mm") UTC</time></dd></div><div><dt>Thời lượng</dt><dd>@session.DurationMinutes phút</dd></div><div><dt>Lượt làm bài</dt><dd>Một lượt duy nhất</dd></div></dl></section>
<section class="surface"><h2>Hướng dẫn làm bài</h2><p class="pre-line">@Model.Instructions</p><ul class="instruction-list"><li>Chọn một đáp án cho mỗi câu. Bạn có thể đánh dấu câu để xem lại.</li><li>Đợi thông báo “Đã lưu” sau khi chọn đáp án. Tải lại trang sẽ khôi phục dữ liệu máy chủ đã lưu.</li><li>Thời gian vẫn tiếp tục khi mất mạng. Bài được kết thúc khi hết giờ.</li><li>Kiểm tra bài trước khi nộp. Điểm chỉ hiển thị sau khi cán bộ công bố.</li></ul>
    @if(session.AttemptId is long attemptId)
    { <a class="btn btn-primary" asp-controller="Attempts" asp-action="Take" asp-route-id="@attemptId">Mở bài thi của bạn</a> }
    else if(session.Status == "Open")
    { <form asp-action="Start" asp-route-id="@session.Id" method="post" data-confirm="Bắt đầu lượt thi duy nhất? Thời gian làm bài sẽ tính ngay sau khi bắt đầu."><button class="btn btn-primary" type="submit">Bắt đầu làm bài</button></form> }
    else
    { <div class="notice" role="status">Hiện chưa thể bắt đầu làm bài. Chỉ đợt thi đang mở mới cho phép bắt đầu.</div> }
</section>
