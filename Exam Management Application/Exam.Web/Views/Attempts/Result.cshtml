@model ResultVm
@{ ViewData["Title"] = "Kết quả bài thi"; }
<a class="back-link" asp-action="History">Về lịch sử thi</a>
<div class="page-heading"><div><h1>@Model.Title</h1><p class="muted">Kết quả bài thi</p></div></div>
<section class="surface mb-4">
@if(Model.Status=="InProgress")
{<h2>Bài thi đang làm</h2><p>Bạn chưa kết thúc lượt thi này.</p><a class="btn btn-primary" asp-action="Take" asp-route-id="@Model.AttemptId">Tiếp tục làm bài</a>}
else if(Model.Status=="PendingGrading")
{<h2>Đang chờ chấm điểm</h2><p>Bài thi đã kết thúc. Hệ thống đang xử lý kết quả; bạn có thể tải lại sau.</p><a class="btn btn-outline-primary" asp-action="Result" asp-route-id="@Model.AttemptId">Tải lại kết quả</a>}
else if(!Model.Published)
{<h2>Đã kết thúc bài thi</h2><p>Kết quả chưa được giảng viên công bố. Tải lại sau khi giảng viên bật công bố.</p><a class="btn btn-outline-primary" asp-action="Result" asp-route-id="@Model.AttemptId">Tải lại kết quả</a>}
else if(Model.Score is null)
{<h2>Đang xử lý kết quả</h2><p>Bài thi đã kết thúc; kết quả đang được xử lý.</p><a class="btn btn-outline-primary" asp-action="Result" asp-route-id="@Model.AttemptId">Tải lại kết quả</a>}
else
{<h2>Điểm bài thi</h2><p class="result-score">@Model.Score.Value.ToString("0.##") <span>/ 10</span></p><p>@Model.CorrectCount / @Model.QuestionCount câu đúng</p>}
@if(Model.SubmittedAt is DateTime submitted){<p class="small muted mb-0">Kết thúc lúc <time data-local-time="@DateTime.SpecifyKind(submitted, DateTimeKind.Utc).ToString("O")">@submitted.ToString("dd/MM/yyyy HH:mm") UTC</time></p>}
</section>
@if(Model.Published && Model.Questions.Count>0)
{
    <section aria-labelledby="review-heading">
        <h2 id="review-heading">Xem lại bài làm</h2>
        <p class="small muted">Nội dung được hiển thị theo chính sách công bố của đợt thi.</p>
        @for (var i = 0; i < Model.Questions.Count; i++)
        {
            var question = Model.Questions[i];
            var answerClass = question.IsCorrect switch { true => "review-correct", false => "review-incorrect", _ => "" };
            var status = question.IsCorrect == true ? "Đúng" : question.SelectedAnswer is null ? "Chưa trả lời" : "Sai";
            <article class="surface mb-3 @answerClass">
                <h3 class="review-status">Câu @(i + 1) @if (question.IsCorrect.HasValue) { <span>· @status</span> }</h3>
                <div class="review-question question-markdown">@question.Text</div>
                <div class="review-selection"><strong>Đáp án đã chọn:</strong><div class="question-markdown">@(question.SelectedAnswer ?? "Chưa trả lời")</div></div>
                @if (question.CorrectAnswer is not null)
                {
                    <div class="review-correct-answer"><strong>Đáp án đúng:</strong><div class="question-markdown">@question.CorrectAnswer</div></div>
                }
            </article>
        }
    </section>
}
