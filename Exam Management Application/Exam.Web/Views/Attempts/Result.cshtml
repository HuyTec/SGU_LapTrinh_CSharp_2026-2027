@model ResultVm
@{ ViewData["Title"] = "Kết quả bài thi"; }
<a class="back-link" asp-action="History">Về lịch sử thi</a>
<div class="page-heading"><div><p class="uc-label">UC-08</p><h1>@Model.Title</h1><p class="muted">Kết quả bài thi</p></div></div>
<section class="surface mb-4">
@if(Model.Status=="InProgress")
{<h2>Bài thi đang làm</h2><p>Bạn chưa kết thúc lượt thi này.</p><a class="btn btn-primary" asp-action="Take" asp-route-id="@Model.AttemptId">Tiếp tục làm bài</a>}
else if(Model.Status=="PendingGrading")
{<h2>Đang chờ chấm điểm</h2><p>Bài thi đã kết thúc. Hệ thống đang xử lý kết quả; bạn có thể tải lại sau.</p><a class="btn btn-outline-primary" asp-action="Result" asp-route-id="@Model.AttemptId">Tải lại kết quả</a>}
else if(!Model.Published)
{<h2>Đã kết thúc bài thi</h2><p class="mb-0">Kết quả chưa được công bố. Vui lòng quay lại sau khi cán bộ phụ trách công bố điểm.</p>}
else if(Model.Score is null)
{<h2>Đang xử lý kết quả</h2><p>Bài thi đã kết thúc; kết quả đang được xử lý.</p><a class="btn btn-outline-primary" asp-action="Result" asp-route-id="@Model.AttemptId">Tải lại kết quả</a>}
else
{<h2>Điểm bài thi</h2><p class="result-score">@Model.Score.Value.ToString("0.##") <span>/ 10</span></p><p>@Model.CorrectCount / @Model.QuestionCount câu đúng</p>}
@if(Model.SubmittedAt is DateTime submitted){<p class="small muted mb-0">Kết thúc lúc <time data-local-time="@DateTime.SpecifyKind(submitted, DateTimeKind.Utc).ToString("O")">@submitted.ToString("dd/MM/yyyy HH:mm") UTC</time></p>}
</section>
@if(Model.Published && Model.Questions.Count>0)
{<section aria-labelledby="review-heading"><h2 id="review-heading">Xem lại bài làm</h2><p class="small muted">Nội dung được hiển thị theo chính sách công bố của đợt thi.</p>@for(var i=0;i<Model.Questions.Count;i++){var q=Model.Questions[i];<article class="surface mb-3"><h3>Câu @(i+1)</h3><p class="pre-line">@q.Text</p><p><strong>Đáp án đã chọn:</strong> @(q.SelectedAnswer ?? "Chưa trả lời")</p>@if(q.CorrectAnswer is not null){<p><strong>Đáp án đúng:</strong> @q.CorrectAnswer</p>}@if(q.IsCorrect.HasValue){<p class="mb-0">@(q.IsCorrect.Value ? "Trả lời đúng" : "Trả lời chưa đúng hoặc bỏ trống")</p>}</article>}</section>}
