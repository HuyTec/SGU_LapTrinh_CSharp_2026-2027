@model Exam.Web.ViewModels.RegisterVm
@{ ViewData["Title"] = "Đăng ký tài khoản"; var lecturer = Model.AccountType == "Lecturer"; }
<section class="login-panel surface" aria-labelledby="register-heading">
    <h1 id="register-heading">Đăng ký tài khoản</h1>
    <nav class="nav nav-tabs mb-3" aria-label="Loại tài khoản đăng ký">
        <a class="nav-link @(!lecturer ? "active" : "")" aria-current="@(!lecturer ? "page" : null)" asp-action="Register" asp-route-accountType="Student">Thí sinh</a>
        <a class="nav-link @(lecturer ? "active" : "")" aria-current="@(lecturer ? "page" : null)" asp-action="Register" asp-route-accountType="Lecturer">Giảng viên</a>
    </nav>
    <h2>@(lecturer ? "Đăng ký giảng viên" : "Đăng ký thí sinh")</h2>
    <p class="muted">@(lecturer ? "Bạn có thể đăng nhập ngay sau khi đăng ký." : "Dùng mã thí sinh do nhà trường cấp. Bạn có thể đăng nhập ngay sau khi đăng ký.")</p>
    <form asp-controller="Account" asp-action="Register" method="post">
        <input type="hidden" name="AccountType" value="@(lecturer ? "Lecturer" : "Student")" />
        <div asp-validation-summary="ModelOnly" class="validation-summary text-danger" role="alert"></div>
        <span asp-validation-for="AccountType" class="text-danger"></span>
        <div class="mb-3"><label asp-for="UserName" class="form-label">Tên đăng nhập</label><input asp-for="UserName" class="form-control" autocomplete="username" maxlength="60" required /><span asp-validation-for="UserName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="FullName" class="form-label">Họ và tên</label><input asp-for="FullName" class="form-control" autocomplete="name" maxlength="120" required /><span asp-validation-for="FullName" class="text-danger"></span></div>
        @if (!lecturer)
        {
            <div class="mb-3"><label asp-for="StudentCode" class="form-label">Mã thí sinh</label><input asp-for="StudentCode" class="form-control" maxlength="30" required /><span asp-validation-for="StudentCode" class="text-danger"></span></div>
        }
        <div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" maxlength="256" required /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="PhoneNumber" class="form-label">Số điện thoại</label><input asp-for="PhoneNumber" type="tel" class="form-control" autocomplete="tel" maxlength="20" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu</label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" minlength="8" required aria-describedby="password-help" /><div id="password-help" class="form-text">Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</div><span asp-validation-for="Password" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu</label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" minlength="8" required /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button type="submit" class="btn btn-primary w-100">Đăng ký tài khoản</button>
    </form>
    <p class="mt-4 mb-2">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
    <a asp-controller="Help" asp-action="Index">Hướng dẫn sử dụng</a>
</section>
